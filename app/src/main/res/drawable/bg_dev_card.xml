<?xml version="1.0" encoding="utf-8"?>
<!--
    Background drawable for the "DEVELOPED BY" card on the splash screen.
    Matches the screenshot: dark semi-transparent rounded rectangle with a
    subtle lighter border.
    Place in:  res/drawable/bg_dev_card.xml
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Dark green fill, slightly lighter than the main #0D2D0F background -->
    <solid android:color="#163D1A" />

    <!-- Subtle border — one shade lighter to give a card 'lift' -->
    <stroke
        android:width="1dp"
        android:color="#2A5C30" />

    <!-- Rounded corners matching the screenshot -->
    <corners android:radius="16dp" />

</shape>