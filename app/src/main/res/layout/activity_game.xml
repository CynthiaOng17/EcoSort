<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#124015">

    <!-- HUD bar -->
    <LinearLayout
        android:id="@+id/hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0D2D0F"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:gravity="center_vertical"
        android:elevation="4dp">

        <!-- Exit button (✖) -->
        <TextView
            android:id="@+id/btn_exit"
            android:text="✖"
            android:textSize="22sp"
            android:textColor="#4CAF72"
            android:paddingEnd="14dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true" />

        <!-- Score: two lines -->
        <TextView
            android:id="@+id/tv_score"
            android:text="Score:\n0"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#E8F5EA"
            android:lineSpacingMultiplier="1.1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <!-- Timer with clock emoji -->
        <TextView
            android:id="@+id/tv_timer"
            android:text="⏱ 0:42"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFB82E"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp" />

        <!-- Lives — pink hearts -->
        <TextView
            android:id="@+id/tv_lives"
            android:text="❤️❤️❤️"
            android:textSize="20sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/btn_mute"
            android:text="🔊"
            android:textSize="22sp"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

    </LinearLayout>

    <!-- Streak/Multiplier indicator -->
    <TextView
        android:id="@+id/tv_streak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="85dp"
        android:background="#99000000"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:textColor="#FFEB3B"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:elevation="10dp" />

    <!-- Pollution overlay (shown on wrong sort) -->
    <View
        android:id="@+id/pollution_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99D94F3D"
        android:clickable="false"
        android:visibility="gone" />

    <!-- Bins row -->
    <LinearLayout
        android:id="@+id/bins_row"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_gravity="bottom"
        android:background="#0A1A0C"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp">

        <!-- Organic bin -->
        <LinearLayout
            android:id="@+id/bin_organic"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_card_organic"
            android:layout_marginHorizontal="4dp">

            <TextView
                android:text="🟣"
                android:textSize="40sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp" />

            <TextView
                android:text="@string/organic"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:textColor="#FFFFFF"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Recycling bin (centre / highlighted) -->
        <LinearLayout
            android:id="@+id/bin_recycle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_card_recycle"
            android:layout_marginHorizontal="4dp">

            <TextView
                android:text="♻️"
                android:textSize="40sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp" />

            <TextView
                android:text="@string/recycle"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:textColor="#3DD68C"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Hazardous bin -->
        <LinearLayout
            android:id="@+id/bin_hazardous"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_card_hazardous"
            android:layout_marginHorizontal="4dp">

            <TextView
                android:text="☣️"
                android:textSize="40sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp" />

            <TextView
                android:text="@string/hazardous"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:textColor="#FF8A40"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

    </LinearLayout>

    <!-- Falling item -->
    <TextView
        android:id="@+id/tv_falling_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:text=""
        android:textSize="64sp"
        android:padding="16dp"
        android:clickable="true"
        android:focusable="true"
        android:elevation="15dp"
        android:gravity="center" />

    <!-- Instructions overlay -->
    <ScrollView
        android:id="@+id/instruction_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000"
        android:clickable="true"
        android:focusable="true"
        android:elevation="20dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingVertical="32dp">

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/how_to_play"
                android:textColor="#3DD68C"
                android:textSize="34sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="14dp" />

            <!-- Subtitle -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/drag_waste"
                android:textColor="#C8E6C9"
                android:textSize="18sp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.5"
                android:layout_marginBottom="16dp" />

            <!-- Scoring Rules -->

            <!-- Bin guide card -->

            <!-- Start button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                android:background="#122814"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/organic"
                    android:textColor="#F5DFA0"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/organic_desc"
                    android:textColor="#F5DFA0"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/recycle"
                    android:textColor="#3DD68C"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/recycle_desc"
                    android:textColor="#3DD68C"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/hazardous"
                    android:textColor="#FF8A40"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/hazardous_desc"
                    android:textColor="#FF8A40"
                    android:textSize="17sp" />

            </LinearLayout>

            <Button
                android:id="@+id/btn_start_game"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="@string/start_game"
                android:backgroundTint="#3DD68C"
                android:textColor="#0D2D0F"
                android:textStyle="bold"
                android:textSize="18sp"
                android:letterSpacing="0.08"
                android:stateListAnimator="@null"
                style="@style/Widget.MaterialComponents.Button" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>