<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D2D0F">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_navigation">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="32dp">

            <TextView
                android:text="♻️"
                android:textSize="56sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" />

            <TextView
                android:text="EcoSort"
                android:textSize="40sp"
                android:textStyle="bold"
                android:textColor="#3DD68C"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp" />

            <TextView
                android:text="@string/choose_difficulty"
                android:textSize="18sp"
                android:textColor="#C8E6C9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp" />

            <TextView
                android:id="@+id/tv_high_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/best_label"
                android:textColor="#FFD54F"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_easy"
                android:text="@string/easy"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#0D2D0F"
                android:background="@drawable/bg_btn_easy"
                android:layout_width="280dp"
                android:layout_height="58dp"
                android:layout_marginBottom="14dp"
                android:stateListAnimator="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_medium"
                android:layout_width="280dp"
                android:layout_height="58dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_btn_medium"
                android:stateListAnimator="@null"
                android:text="@string/medium"
                android:textColor="#FFBA0D"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_hard"
                android:text="@string/hard"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#D94F3D"
                android:background="@drawable/bg_btn_hard"
                android:layout_width="280dp"
                android:layout_height="58dp"
                android:layout_marginBottom="14dp"
                android:stateListAnimator="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_survival"
                android:text="@string/survival"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_survival"
                android:layout_width="280dp"
                android:layout_height="58dp"
                android:stateListAnimator="@null" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_lang"
                android:text="🌐"
                android:textSize="28sp"
                android:padding="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <TextView
                android:id="@+id/btn_mute_menu"
                android:text="🔊"
                android:textSize="28sp"
                android:padding="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />

        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#122814"
        app:itemIconTint="#3DD68C"
        app:itemTextColor="#3DD68C"
        app:menu="@menu/bottom_nav_menu" />



</RelativeLayout>