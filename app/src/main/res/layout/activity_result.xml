<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#122814"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="40dp">

        <!-- ── Hero section ─────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tv_result_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌍"
                android:textSize="52sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tv_result_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/eco_champion"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#A8D5A2"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_result_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/malaysia_proud"
                android:textSize="18sp"
                android:textColor="#C8E6C9" />

            <TextView
                android:id="@+id/tv_new_highscore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/new_record"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFD54F"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

        <!-- ── Stats row: Correct / Wrong / Score ────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp"
            android:baselineAligned="false">

            <!-- Correct -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#0F1F0F"
                android:paddingVertical="12dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/correct_stat"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:textColor="#C8E6C9"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_correct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    tools:text="14"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#4CAF50" />

            </LinearLayout>

            <!-- Wrong -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#0F1F0F"
                android:paddingVertical="12dp"
                android:layout_marginHorizontal="3dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wrong_stat"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:textColor="#C8E6C9"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_wrong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    tools:text="3"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#EF5350" />

            </LinearLayout>

            <!-- Score -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#0F1F0F"
                android:paddingVertical="12dp"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/score_stat"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:textColor="#C8E6C9"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_final_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    tools:text="1380"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#FFD54F" />

            </LinearLayout>

        </LinearLayout>

        <!-- ── Eco Tip ─────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/eco_tip_label"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:textColor="#C8E6C9"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#0F1F0F"
            android:layout_marginBottom="20dp">

            <!-- Left green accent bar -->
            <View
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:background="#4CAF50" />

            <TextView
                android:id="@+id/tv_eco_tip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="18sp"
                android:textColor="#8BC34A"
                android:lineSpacingMultiplier="1.5"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp" />

        </LinearLayout>

        <!-- ── Items in this round label ─────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/items_round_label"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:textColor="#C8E6C9"
            android:layout_marginBottom="6dp" />

        <!-- Items summary card (Scrollable area) -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginBottom="16dp"
            android:background="#0F1F0F"
            android:scrollbars="vertical"
            android:fadeScrollbars="false"
            android:scrollbarThumbVertical="@android:color/darker_gray">

            <LinearLayout
                android:id="@+id/ll_item_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingTop="0dp"
                android:paddingBottom="10dp" />

        </androidx.core.widget.NestedScrollView>

        <!-- Share Button -->
        <Button
            android:id="@+id/btn_share"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="8dp"
            android:text="@string/share_score"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#1976D2"
            android:stateListAnimator="@null"
            style="@style/Widget.MaterialComponents.Button" />

        <!-- ── Buttons ─────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Play Again -->
            <Button
                android:id="@+id/btn_play_again"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/play_again"
                android:textColor="#C8E6C9"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="#2E7D32"
                android:stateListAnimator="@null"
                style="@style/Widget.MaterialComponents.Button" />

            <!-- Main Menu -->
            <Button
                android:id="@+id/btn_main_menu"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="@string/main_menu"
                android:textColor="#81C784"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="#1B2E1B"
                android:stateListAnimator="@null"
                style="@style/Widget.MaterialComponents.Button" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>