<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splash_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D2D0F"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginBottom="20dp">
        <TextView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/circle_glow_bg"
            android:gravity="center"
            android:text="♻️"
            android:textColor="#FFFFFF"
            android:textSize="64sp" />
    </FrameLayout>

    <TextView
        android:text="EcoSort"
        android:textSize="52sp"
        android:textStyle="bold"
        android:textColor="#3DD68C"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="64dp"
        android:text="Sort waste. Save the planet."
        android:textColor="#8FBFA0"
        android:textSize="20sp" />

    <LinearLayout
        android:background="@drawable/bg_dev_card"
        android:paddingHorizontal="28dp"
        android:paddingVertical="16dp"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
            android:text="DEVELOPED BY"
            android:textSize="18sp"
            android:textColor="#5A8C62"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_student_name"
            android:text="Cynthia Ong Ka"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#E8F5EA"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tv_matric"
            android:text="23004897"
            android:textSize="18sp"
            android:textColor="#6DAE78"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />
    </LinearLayout>


</LinearLayout>